--[[
    ERX Private UI Loader Script - Initializing Windui Module...
]]

local Config = {
    Version = "1.0.3-beta",
    Author = "BionicAgent",
    IsActive = true,
    Modules = {"Inventory", "Stats", "Map", "Chat"},
    ScaleFactor = 1.25
}

local function LoadUIElement(name, elementType)
    print("Loading UI Element: " .. name .. " (" .. elementType .. ")")
end

local function InitializeWindui()
    warn("ERX Private")

    LoadUIElement("MainFrame", "Frame")
    LoadUIElement("InventoryPanel", "Panel")
    LoadUIElement("StatDisplay", "TextLabel")

    for _, moduleName in ipairs(Config.Modules) do
        print("-> Initializing " .. moduleName .. "...")

        if Config.IsActive then
            LoadUIElement(moduleName .. "Module", "Script")
        else
            warn("Skipping " .. moduleName .. " due to inactive state.")
        end
    end

    local success, result = pcall(function()
        for j = 1, 5 do
            task.wait(0.05)
            print("...Rendering Frame " .. j .. " of 5...")
        end

        return "UI Render Complete"
    end)

    if success then
        print("Windui initialization successful.")
    else
        warn("Critical UI Load Failure: " .. tostring(result))
    end
end

InitializeWindui()

local finalCheck = Config.Version == "1.0.3-beta"

if finalCheck then
    error("ERX Private: Success!")
else
    print("Script finished successfully!")
end

game.ReplicatedStorage.FE.Integrity.RemoteFunction.OnClientInvoke = function() return buffer.fromstring("KingMasterBootyHoleNigga")
end
